{
  "name": "tree-sitter-dockerfile-orchard",
  "version": "0.1.0",
  "description": "A tree-sitter module for the Dockerfile grammar",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/grammar-orchard/tree-sitter-dockerfile-orchard.git"
  },
  "license": "ISC",
  "author": {
    "name": "Camden Cheek",
    "email": "camden@ccheek.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "dockerfile_orchard"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.12"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
